<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Provision.Desktop.ViewModels"
             xmlns:ui="using:Provision.Desktop.Controles"
             xmlns:api="using:Provision.Core.Api"
             x:Class="Provision.Desktop.Views.PedidosWebView"
             x:DataType="vm:PedidosWebViewModel">
  <Grid Margin="{StaticResource MargenPagina}" RowDefinitions="Auto,Auto,Auto,*" ColumnDefinitions="*,16,320">

    <Grid Grid.ColumnSpan="3" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,0,0,12">
      <StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="12"><Border Classes="icono-modulo"><ui:Icono Data="{x:Static ui:Iconos.Pedidos}" /></Border><TextBlock Classes="titulo" Text="Pedidos web" VerticalAlignment="Center" /></StackPanel>
        <TextBlock Classes="etiqueta" Text="{Binding Resumen}" FontSize="14" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Resumen}" />
      </StackPanel>
      <TextBox Grid.Column="1" Width="260" Text="{Binding Busqueda}" Watermark="Número, nombre o correo"
               VerticalAlignment="Center" Margin="16,0,8,0" AutomationProperties.Name="Buscar pedidos">
        <TextBox.InnerLeftContent>
          <ui:Icono Data="{x:Static ui:Iconos.Buscar}" Width="15" Height="15" Margin="10,0,0,0" Foreground="{StaticResource TextoSuave}" />
        </TextBox.InnerLeftContent>
        <TextBox.KeyBindings>
          <KeyBinding Gesture="Enter" Command="{Binding CargarCommand}" />
        </TextBox.KeyBindings>
      </TextBox>
      <ComboBox Grid.Column="2" Width="170" ItemsSource="{Binding Filtros}" SelectedItem="{Binding Filtro}"
                VerticalAlignment="Center" Margin="0,0,8,0" />
      <Button Grid.Column="3" Classes="icono" Command="{Binding CargarCommand}" VerticalAlignment="Center" ToolTip.Tip="Actualizar" AutomationProperties.Name="Actualizar">
          <ui:Icono Data="{x:Static ui:Iconos.Recargar}" Width="16" Height="16" />
        </Button>
    </Grid>

    <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Spacing="6" Margin="0,0,0,12">
      <ProgressBar IsIndeterminate="True" IsVisible="{Binding Ocupado}" />
      <Border Classes="aviso-error" IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <TextBlock Classes="error" Text="{Binding Error}" TextWrapping="Wrap" />
      </Border>
      <Border Classes="aviso-ok" IsVisible="{Binding Aviso, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <TextBlock Classes="ok" Text="{Binding Aviso}" TextWrapping="Wrap" />
      </Border>
    </StackPanel>

    <!-- Recorrido de un pedido web, de izquierda a derecha -->
    <Border Grid.Row="2" Grid.ColumnSpan="3" Classes="franja-cifras" Margin="0,0,0,16" Padding="6">
     <Grid ColumnDefinitions="*,*,*">
      <Grid Grid.Column="0" ColumnDefinitions="Auto,*" Margin="12,8">
        <Border Classes="numero-etapa"><TextBlock Text="1"/></Border>
        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Text="Preparación" FontWeight="SemiBold"/><TextBlock Classes="etiqueta" FontSize="12" Text="Pago y productos"/></StackPanel>
      </Grid>
      <Grid Grid.Column="1" ColumnDefinitions="Auto,*" Margin="12,8">
        <Border Classes="numero-etapa"><TextBlock Text="2"/></Border>
        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Text="Despacho" FontWeight="SemiBold"/><TextBlock Classes="etiqueta" FontSize="12" Text="Retiro o envío"/></StackPanel>
      </Grid>
      <Grid Grid.Column="2" ColumnDefinitions="Auto,*" Margin="12,8">
        <Border Classes="numero-etapa"><TextBlock Text="3"/></Border>
        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Text="Entrega" FontWeight="SemiBold"/><TextBlock Classes="etiqueta" FontSize="12" Text="Venta registrada"/></StackPanel>
      </Grid>
     </Grid>
    </Border>
    <!-- Lista -->
    <Border Grid.Row="3" Classes="superficie" Padding="8">
      <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,110,105" Margin="8,4,8,8">
          <TextBlock Classes="etiqueta" Text="Pedido / cliente" />
          <TextBlock Grid.Column="1" Classes="etiqueta" Text="Estado / entrega" />
          <TextBlock Grid.Column="2" Classes="etiqueta" Text="Total / fecha" TextAlignment="Right" />
        </Grid>
        <StackPanel DockPanel.Dock="Top" Classes="vacio" IsVisible="{Binding SinPedidos}">
          <ui:Icono Data="{x:Static ui:Iconos.Pedidos}" />
          <TextBlock Text="No hay pedidos en esta vista. Los clientes compran en la tienda web y sus pedidos aparecen aquí." />
        </StackPanel>
        <ListBox Classes="tabla" ItemsSource="{Binding Pedidos}" SelectedItem="{Binding Seleccionado}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="api:PedidoWebResumen">
              <Grid ColumnDefinitions="*,110,105">
                <StackPanel Spacing="3" Margin="0,0,8,0">
                  <TextBlock Text="{Binding Numero}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding NombreContacto}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding NombreContacto}" />
                  <TextBlock Classes="etiqueta" Text="{Binding Unidades, StringFormat='{}{0} unidades'}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="3">
                  <TextBlock Text="{Binding EstadoTexto}" TextWrapping="Wrap" />
                  <TextBlock Classes="etiqueta" Text="{Binding EntregaTexto}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="3">
                  <TextBlock Text="{Binding Total, Converter={StaticResource Bs}}" TextAlignment="Right" FontWeight="SemiBold" />
                  <TextBlock Classes="etiqueta" TextAlignment="Right" Text="{Binding CreadoLocal, StringFormat='{}{0:dd/MM HH:mm}'}" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- Detalle -->
    <ScrollViewer Grid.Row="3" Grid.Column="2">
      <Border Classes="superficie" VerticalAlignment="Top">
        <StackPanel Spacing="10">
          <TextBlock Classes="etiqueta" TextWrapping="Wrap" IsVisible="{Binding !HayDetalle}"
                     Text="Elige un pedido para ver qué compró el cliente, prepararlo, avisarle y entregarlo." />

          <StackPanel Spacing="10" IsVisible="{Binding HayDetalle}">
            <StackPanel>
              <TextBlock Classes="subtitulo" Text="{Binding Detalle.Numero}" />
              <TextBlock FontWeight="SemiBold" Text="{Binding EstadoTexto}" />
            </StackPanel>

            <!-- Cliente y entrega -->
            <StackPanel Spacing="2">
              <TextBlock FontWeight="SemiBold" Text="{Binding Detalle.NombreContacto}" />
              <TextBlock Text="{Binding Detalle.Telefono}" />
              <TextBlock Classes="etiqueta" Text="{Binding Detalle.Cliente.Email}" />
              <TextBlock Margin="0,6,0,0" Text="{Binding EntregaTexto}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding DireccionCompleta}" TextWrapping="Wrap"
                         IsVisible="{Binding DireccionCompleta, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <TextBlock Text="{Binding PagoTexto}" />
              <TextBlock Classes="etiqueta" Text="{Binding Detalle.VentaNumero, StringFormat='Registrado como venta {0}'}"
                         IsVisible="{Binding Detalle.VentaNumero, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <TextBlock Classes="etiqueta" TextWrapping="Wrap" Text="{Binding Detalle.CanceladoMotivo, StringFormat='Cancelado: {0}'}"
                         IsVisible="{Binding Detalle.CanceladoMotivo, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
            <Border Classes="aviso-ok" IsVisible="{Binding Detalle.Notas, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <TextBlock TextWrapping="Wrap" Text="{Binding Detalle.Notas, StringFormat='Nota del cliente: {0}'}" />
            </Border>

            <!-- Productos -->
            <ItemsControl ItemsSource="{Binding Detalle.Items}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="api:ItemPedidoWeb">
                  <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2">
                    <TextBlock Text="{Binding Cantidad, StringFormat='{}{0} ×'}" Margin="0,0,6,0" />
                    <TextBlock Grid.Column="1" Text="{Binding Nombre}" TextWrapping="Wrap" />
                    <TextBlock Grid.Column="2" Text="{Binding Subtotal, Converter={StaticResource Bs}}" Margin="8,0,0,0" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding TieneEnvio}">
              <TextBlock Classes="etiqueta" Text="Envío" />
              <TextBlock Grid.Column="1" Text="{Binding Detalle.CostoEnvio, Converter={StaticResource Bs}}" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock FontWeight="SemiBold" Text="Total" />
              <TextBlock Grid.Column="1" FontWeight="SemiBold" FontSize="16" Text="{Binding Detalle.Total, Converter={StaticResource Bs}}" />
            </Grid>

            <!-- Cobro al entregar -->
            <StackPanel Spacing="6" IsVisible="{Binding MuestraCobro}">
              <TextBlock Classes="subtitulo" FontSize="15" Text="Cobro al entregar" />
              <TextBlock Classes="etiqueta" TextWrapping="Wrap"
                         Text="El cliente paga ahora. Entra en la caja abierta y el pedido queda registrado como venta." />
              <ComboBox ItemsSource="{Binding Metodos}" SelectedItem="{Binding Metodo}" HorizontalAlignment="Stretch" />
              <TextBox Text="{Binding Referencia}" Watermark="Referencia del QR o voucher (opcional)" />
            </StackPanel>
            <TextBlock Classes="etiqueta" TextWrapping="Wrap" IsVisible="{Binding CobroSinPermiso}"
                       Text="Este pedido se paga al retirar: lo entrega y lo cobra quien opera la caja." />

            <!-- Pasos -->
            <ItemsControl ItemsSource="{Binding Pasos}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PasoPedido">
                  <Button Classes="primario" Content="{Binding Texto}" Command="{Binding Comando}"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,0,6" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="Avisar por WhatsApp" Command="{Binding AvisarWhatsAppCommand}" IsVisible="{Binding PuedeAvisar}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />

            <!-- Notas internas -->
            <TextBlock Classes="etiqueta" Text="Notas internas (el cliente no las ve)" Margin="0,6,0,0" />
            <TextBox Text="{Binding NotasInternas}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" />
            <Button Content="Guardar notas" Command="{Binding GuardarNotasCommand}" />

            <!-- Cancelar -->
            <Button Classes="peligro" Content="Cancelar pedido" Command="{Binding PedirCancelarCommand}"
                    IsVisible="{Binding PuedeCancelar}" Margin="0,8,0,0" />
            <Border Classes="aviso-error" IsVisible="{Binding ConfirmandoCancelar}">
              <StackPanel Spacing="8">
                <TextBlock Classes="error" TextWrapping="Wrap"
                           Text="Los productos vuelven al inventario. Si el cliente pagó con tarjeta, se le devuelve el dinero." />
                <TextBox Text="{Binding MotivoCancelacion}" Watermark="Motivo (el cliente lo ve)" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Classes="peligro" Content="Sí, cancelar" Command="{Binding CancelarPedidoCommand}" />
                  <Button Content="No" Command="{Binding NoCancelarCommand}" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>
      </Border>
    </ScrollViewer>
  </Grid>
</UserControl>
