<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Provision.Desktop.ViewModels"
             x:Class="Provision.Desktop.Views.LoginView"
             x:DataType="vm:LoginViewModel">
  <Grid ColumnDefinitions="*,*">

    <!-- Panel de marca -->
    <Border Grid.Column="0" Background="{StaticResource Barra}">
      <StackPanel VerticalAlignment="Center" Margin="64" Spacing="12">
        <TextBlock Text="Provisión" FontSize="44" FontWeight="Bold" Foreground="White" />
        <TextBlock Text="Inventario, caja, ventas y finanzas para tu óptica."
                   FontSize="18" Foreground="#94A3B8" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <!-- Formulario -->
    <Border Grid.Column="1" Classes="tarjeta" Width="400"
            HorizontalAlignment="Center" VerticalAlignment="Center" Padding="32">
      <StackPanel Spacing="14">
        <TextBlock Classes="titulo" Text="Ingresar" />

        <StackPanel Spacing="4">
          <TextBlock Classes="etiqueta" Text="Entorno" />
          <ComboBox ItemsSource="{Binding Entornos}" SelectedItem="{Binding EntornoSeleccionado}"
                    HorizontalAlignment="Stretch" />
          <TextBlock Classes="etiqueta" Text="{Binding UrlDestino}" FontSize="11" />
        </StackPanel>

        <StackPanel Spacing="4">
          <TextBlock Classes="etiqueta" Text="Correo" />
          <TextBox Text="{Binding Email}" Watermark="tu@correo.com" />
        </StackPanel>

        <StackPanel Spacing="4">
          <TextBlock Classes="etiqueta" Text="Contraseña" />
          <TextBox Text="{Binding Password}" PasswordChar="●" Watermark="Contraseña">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding IngresarCommand}" />
            </TextBox.KeyBindings>
          </TextBox>
        </StackPanel>

        <Button Classes="primario" Content="Ingresar" HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center" Command="{Binding IngresarCommand}" />

        <ProgressBar IsIndeterminate="True" IsVisible="{Binding Ocupado}" />
        <TextBlock Classes="etiqueta" Text="{Binding Aviso}" TextWrapping="Wrap"
                   IsVisible="{Binding Aviso, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <Border Classes="aviso-error" IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <TextBlock Classes="error" Text="{Binding Error}" />
        </Border>
        <TextBlock Classes="etiqueta" FontSize="12" HorizontalAlignment="Center" Text="{Binding VersionApp}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
