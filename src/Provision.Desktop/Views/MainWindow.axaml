<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Provision.Desktop.ViewModels"
        x:Class="Provision.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Provisión"
        Width="1320" Height="820"
        MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Fondo}">
  <Grid>
    <ContentControl Content="{Binding Contenido}" IsEnabled="{Binding !Bloqueada}" />
    <!-- Actualización obligatoria: tapa todo hasta instalar la versión nueva -->
    <ContentControl Content="{Binding Actualizacion}" IsVisible="{Binding Bloqueada}" />
  </Grid>
</Window>
