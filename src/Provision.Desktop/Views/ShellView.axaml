<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="using:Provision.Desktop.ViewModels" xmlns:ui="using:Provision.Desktop.Controles"
 x:Class="Provision.Desktop.Views.ShellView" x:DataType="vm:ShellViewModel">
 <UserControl.KeyBindings>
  <KeyBinding Gesture="F5" Command="{Binding ActualizarSeccionCommand}" />
 </UserControl.KeyBindings>
 <!-- Sin barra superior: cada pantalla trae su propio título, y el contexto (sucursal, entorno) vive en el menú. -->
 <Grid ColumnDefinitions="232,*" Background="{StaticResource Fondo}">
  <Border Background="{StaticResource Barra}" Padding="12,18,12,12">
   <DockPanel>
    <StackPanel DockPanel.Dock="Top" Spacing="14" Margin="0,0,0,16">
     <Grid ColumnDefinitions="40,*" Margin="8,0,0,0">
      <Border Background="{StaticResource Cristal}" CornerRadius="11" Width="36" Height="36"><ui:Icono Data="{x:Static ui:Iconos.Marca}" Foreground="{StaticResource Barra}" Width="24" Height="24" /></Border>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0" Spacing="1">
       <TextBlock Text="provisión" FontSize="20" FontWeight="SemiBold" Foreground="White" LetterSpacing="-0.3"/>
       <TextBlock Text="Gestión de ópticas" FontSize="11" Foreground="{StaticResource BarraTextoSuave}"/>
      </StackPanel>
     </Grid>

     <!-- Contexto de trabajo: sucursal y entorno siempre a la vista -->
     <Border Classes="contexto-barra">
      <Grid ColumnDefinitions="*,Auto">
       <StackPanel VerticalAlignment="Center" Spacing="1">
        <TextBlock Text="{Binding SucursalActual}" Foreground="White" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SucursalActual}"/>
        <TextBlock Text="{Binding NombreEntorno}" Foreground="{StaticResource BarraTextoSuave}" FontSize="11"/>
       </StackPanel>
       <Button Grid.Column="1" Classes="nav icono" Padding="6" MinHeight="30" MinWidth="30" Command="{Binding ActualizarSeccionCommand}"
               ToolTip.Tip="Actualizar sección (F5)" AutomationProperties.Name="Actualizar sección">
        <ui:Icono Data="{x:Static ui:Iconos.Recargar}" Width="15" Height="15"/>
       </Button>
      </Grid>
     </Border>

     <Button Classes="accion-barra" Command="{Binding IrAVenderCommand}" IsVisible="{Binding PuedeVender}" AutomationProperties.Name="Nueva venta">
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
       <ui:Icono Data="{x:Static ui:Iconos.Mas}" Width="15" Height="15"/>
       <TextBlock Text="Nueva venta"/>
      </StackPanel>
     </Button>
    </StackPanel>

    <!-- Perfil -->
    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BarraBorde}" BorderThickness="0,1,0,0" Padding="6,12,0,2" Margin="0,10,0,0">
     <Grid ColumnDefinitions="32,*,30">
      <Border Background="{StaticResource Cristal}" CornerRadius="16" Width="32" Height="32" VerticalAlignment="Center">
       <TextBlock Text="{Binding Iniciales}" Foreground="{StaticResource Barra}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <StackPanel Grid.Column="1" Margin="10,0,4,0" VerticalAlignment="Center" Spacing="1">
       <TextBlock Text="{Binding NombreUsuario}" Foreground="White" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding NombreUsuario}"/>
       <TextBlock Text="{Binding RolUsuario}" Foreground="{StaticResource BarraTextoSuave}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding RolUsuario}"/>
      </StackPanel>
      <Button Grid.Column="2" Classes="nav icono" Padding="6" MinHeight="30" MinWidth="30" VerticalAlignment="Center"
              Command="{Binding CerrarSesionCommand}" ToolTip.Tip="Cerrar sesión" AutomationProperties.Name="Cerrar sesión">
       <ui:Icono Data="{x:Static ui:Iconos.Salir}" Width="15" Height="15"/>
      </Button>
     </Grid>
    </Border>

    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
     <ItemsControl ItemsSource="{Binding Grupos}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:GrupoMenu">
      <StackPanel Margin="0,0,0,14" Spacing="2">
       <TextBlock Text="{Binding Titulo}" Foreground="{StaticResource BarraTextoSuave}" FontSize="11" FontWeight="Medium" Margin="12,0,0,4"/>
       <ItemsControl ItemsSource="{Binding Opciones}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:OpcionMenu">
        <Button Classes="nav" Classes.activo="{Binding Activo}" Command="{Binding Seleccionar}" AutomationProperties.Name="{Binding Titulo}">
         <Grid ColumnDefinitions="28,*"><Border Classes="marca-activo" Width="3" Height="18" CornerRadius="2" Background="{StaticResource Cristal}" HorizontalAlignment="Left" Margin="-12,0,0,0"/><ui:Icono Data="{Binding Icono}" Width="17" Height="17"/><TextBlock Grid.Column="1" Text="{Binding Titulo}" VerticalAlignment="Center" FontSize="13"/></Grid>
        </Button>
       </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </StackPanel>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </ScrollViewer>
   </DockPanel>
  </Border>

  <Grid Grid.Column="1" RowDefinitions="Auto,*">
   <Border Classes="aviso-error" Margin="24,12,24,0" IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Classes="error" Text="{Binding Error}"/></Border>
   <ContentControl Grid.Row="1" Content="{Binding SeccionActual}"/>
  </Grid>
 </Grid>
</UserControl>
