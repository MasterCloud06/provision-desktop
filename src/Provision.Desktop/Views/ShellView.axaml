<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="using:Provision.Desktop.ViewModels" xmlns:ui="using:Provision.Desktop.Controles"
 x:Class="Provision.Desktop.Views.ShellView" x:DataType="vm:ShellViewModel">
 <Grid ColumnDefinitions="226,*" Background="{StaticResource Fondo}">
  <Border Background="{StaticResource Barra}" Padding="12,20,12,14">
   <DockPanel>
    <StackPanel DockPanel.Dock="Top" Spacing="18" Margin="10,0,10,22">
     <Grid ColumnDefinitions="44,*">
      <Border Background="{StaticResource Cristal}" CornerRadius="14" Width="38" Height="42"><ui:Icono Data="{x:Static ui:Iconos.Marca}" Foreground="{StaticResource Barra}" Width="27" Height="27" /></Border>
      <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="provisión" FontSize="23" FontWeight="SemiBold" Foreground="White"/><TextBlock Text="Óptica · gestión integral" FontSize="11" Foreground="{StaticResource BarraTextoSuave}"/></StackPanel>
     </Grid>
     <Button Classes="primario" Content="Nueva venta" Command="{Binding IrAVenderCommand}" IsVisible="{Binding PuedeVender}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
    </StackPanel>
    <Border DockPanel.Dock="Bottom" Background="{StaticResource BarraActivo}" CornerRadius="12" Padding="10" Margin="0,12,0,0">
     <Grid ColumnDefinitions="34,*,28">
      <Border Background="{StaticResource Cristal}" CornerRadius="17" Width="32" Height="32"><TextBlock Text="{Binding Iniciales}" Foreground="{StaticResource Barra}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      <StackPanel Grid.Column="1" Margin="8,0"><TextBlock Text="{Binding NombreUsuario}" Foreground="White" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding NombreUsuario}"/><TextBlock Text="{Binding RolUsuario}" Foreground="{StaticResource BarraTexto}" FontSize="11" TextTrimming="CharacterEllipsis"/></StackPanel>
      <Button Grid.Column="2" Classes="nav icono" Padding="2" Command="{Binding CerrarSesionCommand}" ToolTip.Tip="Cerrar sesión" AutomationProperties.Name="Cerrar sesión"><ui:Icono Data="{x:Static ui:Iconos.Salir}" Width="16"/></Button>
     </Grid>
    </Border>
    <ScrollViewer><ItemsControl ItemsSource="{Binding Grupos}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:GrupoMenu">
     <StackPanel Margin="0,0,0,17" Spacing="5">
      <TextBlock Text="{Binding Titulo}" Foreground="{StaticResource BarraTextoSuave}" FontSize="11" Margin="12,0,0,4"/>
      <ItemsControl ItemsSource="{Binding Opciones}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:OpcionMenu">
       <Button Classes="nav" Classes.activo="{Binding Activo}" Command="{Binding Seleccionar}" Margin="0,1" AutomationProperties.Name="{Binding Titulo}">
        <Grid ColumnDefinitions="28,*,16"><ui:Icono Data="{Binding Icono}" Width="18" Height="18"/><TextBlock Grid.Column="1" Text="{Binding Titulo}" VerticalAlignment="Center" FontSize="13"/><ui:Icono Grid.Column="2" Data="{x:Static ui:Iconos.Siguiente}" Width="12" IsVisible="{Binding Activo}"/></Grid>
       </Button>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     </StackPanel>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" RowDefinitions="72,*">
   <Border Background="{StaticResource Tarjeta}" BorderBrush="{StaticResource Borde}" BorderThickness="0,0,0,1" Padding="24,12">
    <Grid ColumnDefinitions="*,Auto,Auto">
     <StackPanel VerticalAlignment="Center" Spacing="3"><TextBlock Text="{Binding TituloSeccion}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{Binding CategoriaSeccion}" Classes="etiqueta" FontSize="11"/></StackPanel>
     <StackPanel Grid.Column="1" Margin="16,0,20,0" VerticalAlignment="Center" Spacing="3"><TextBlock Text="{Binding SucursalActual}" FontSize="12" FontWeight="Medium"/><TextBlock Classes="etiqueta" FontSize="11"><Run Text="{Binding NombreUsuario}"/><Run Text=" · "/><Run Text="{Binding NombreEntorno}"/></TextBlock></StackPanel>
     <Button Grid.Column="2" Classes="icono" Command="{Binding ActualizarSeccionCommand}" ToolTip.Tip="Actualizar sección" AutomationProperties.Name="Actualizar sección"><ui:Icono Data="{x:Static ui:Iconos.Recargar}" Width="18"/></Button>
    </Grid>
   </Border>
   <Grid Grid.Row="1" RowDefinitions="Auto,*"><Border Classes="aviso-error" Margin="24,8,24,0" IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Classes="error" Text="{Binding Error}"/></Border><ContentControl Grid.Row="1" Content="{Binding SeccionActual}"/></Grid>
  </Grid>
 </Grid>
</UserControl>