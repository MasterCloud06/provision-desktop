<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Provision.Desktop.ViewModels"
             xmlns:ui="using:Provision.Desktop.Controles"
             xmlns:api="using:Provision.Core.Api"
             x:Class="Provision.Desktop.Views.LaboratorioView"
             x:DataType="vm:LaboratorioViewModel">
  <Grid Margin="{StaticResource MargenPagina}" RowDefinitions="Auto,Auto,Auto,*" ColumnDefinitions="*,16,320">

    <Grid Grid.ColumnSpan="3" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,12">
      <StackPanel>
        <TextBlock Classes="titulo" Text="Laboratorio" />
        <TextBlock Classes="etiqueta" FontSize="14" Text="Órdenes, graduaciones y entregas." />
      </StackPanel>
      <ComboBox Grid.Column="1" Width="300" ItemsSource="{Binding Filtros}" SelectedItem="{Binding Filtro}"
                VerticalAlignment="Center" Margin="0,0,8,0" />
      <Button Grid.Column="2" Command="{Binding CargarCommand}" VerticalAlignment="Center" ToolTip.Tip="Recargar los datos">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ui:Icono Data="{x:Static ui:Iconos.Recargar}" Width="16" Height="16" />
            <TextBlock Text="Actualizar" />
          </StackPanel>
        </Button>
    </Grid>

    <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Spacing="6" Margin="0,0,0,12">
      <ProgressBar IsIndeterminate="True" IsVisible="{Binding Ocupado}" />
      <Border Classes="aviso-error" IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <TextBlock Classes="error" Text="{Binding Error}" />
      </Border>
      <Border Classes="aviso-ok" IsVisible="{Binding Aviso, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <TextBlock Classes="ok" Text="{Binding Aviso}" />
      </Border>
    </StackPanel>

    <Border Grid.Row="2" Grid.ColumnSpan="3" Classes="banda" Margin="0,0,0,16"><Grid ColumnDefinitions="*,20,*,20,*">
      <Button Classes="fantasma" Command="{Binding FiltrarEtapaCommand}" CommandParameter="PENDIENTE" Content="Recepción"/>
      <ui:Icono Grid.Column="1" Data="{x:Static ui:Iconos.Siguiente}" Width="14"/>
      <Button Grid.Column="2" Classes="fantasma" Command="{Binding FiltrarEtapaCommand}" CommandParameter="EN_LABORATORIO" Content="En laboratorio"/>
      <ui:Icono Grid.Column="3" Data="{x:Static ui:Iconos.Siguiente}" Width="14"/>
      <Button Grid.Column="4" Classes="fantasma" Command="{Binding FiltrarEtapaCommand}" CommandParameter="LISTO" Content="Listo para entrega"/>
    </Grid></Border>
    <!-- Lista -->
    <Border Grid.Row="3" Classes="superficie" Padding="8">
      <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,125,90" Margin="8,4,8,8">
          <TextBlock Classes="etiqueta" Text="Orden / cliente" />
          <TextBlock Grid.Column="1" Classes="etiqueta" Text="Estado / entrega" />
          <TextBlock Grid.Column="2" Classes="etiqueta" Text="Saldo" TextAlignment="Right" />
        </Grid>
        <Panel>
          <StackPanel Classes="vacio">
            <StackPanel.IsVisible>
              <MultiBinding Converter="{x:Static BoolConverters.And}">
                <Binding Path="!Ocupado" />
                <Binding Path="!Ordenes.Count" />
              </MultiBinding>
            </StackPanel.IsVisible>
            <ui:Icono Data="{x:Static ui:Iconos.Laboratorio}" />
            <TextBlock Text="No hay órdenes de trabajo en esta vista." />
          </StackPanel>
        <ListBox Classes="tabla" ItemsSource="{Binding Ordenes}" SelectedItem="{Binding Seleccionada}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="api:OrdenTrabajoFila">
              <Grid ColumnDefinitions="*,125,90">
                <StackPanel Spacing="3" Margin="0,0,8,0">
                  <TextBlock Text="{Binding Numero}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Cliente, TargetNullValue='Sin cliente'}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Cliente}" />
                  <TextBlock Classes="etiqueta" Text="{Binding Telefono}" />
                  <TextBlock Classes="etiqueta" Text="{Binding VentaNumero}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="3">
                  <TextBlock Text="{Binding EstadoTexto}" FontWeight="Medium" TextWrapping="Wrap" />
                  <TextBlock Classes="etiqueta" Text="{Binding FechaPrometida, StringFormat='{}{0:dd/MM/yyyy}', TargetNullValue='Sin fecha'}" />
                  <TextBlock Classes="error" Text="Atrasada" FontSize="12" IsVisible="{Binding Atrasada}" />
                </StackPanel>
                <TextBlock Grid.Column="2" Classes="monto" Text="{Binding Saldo, Converter={StaticResource Bs}}" TextAlignment="Right" FontWeight="SemiBold" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        </Panel>
      </DockPanel>
    </Border>

    <!-- Detalle -->
    <ScrollViewer Grid.Row="3" Grid.Column="2">
      <Border Classes="superficie">
        <StackPanel Spacing="10">
          <TextBlock Classes="etiqueta" TextWrapping="Wrap" IsVisible="{Binding !HaySeleccion}"
                     Text="Selecciona una orden para ver la graduación, los productos y avanzar su estado." />

          <StackPanel Spacing="10" IsVisible="{Binding HaySeleccion}">
            <TextBlock Classes="subtitulo" Text="{Binding Detalle.Numero}" />
            <TextBlock Text="{Binding Seleccionada.EstadoTexto}" FontWeight="SemiBold" Foreground="{StaticResource Primario}" />

            <!-- Graduación -->
            <StackPanel Spacing="2" IsVisible="{Binding Detalle.Receta, Converter={x:Static ObjectConverters.IsNotNull}}">
              <TextBlock Classes="etiqueta" Text="Graduación" />
              <TextBlock FontFamily="Consolas, Menlo, monospace" Text="{Binding Detalle.Receta.TextoOd, StringFormat='OD  {0}'}" />
              <TextBlock FontFamily="Consolas, Menlo, monospace" Text="{Binding Detalle.Receta.TextoOi, StringFormat='OI  {0}'}" />
              <TextBlock Classes="etiqueta">
                <Run Text="DNP " />
                <Run Text="{Binding Detalle.Receta.DnpOd}" />
                <Run Text=" / " />
                <Run Text="{Binding Detalle.Receta.DnpOi}" />
                <Run Text=" mm" />
              </TextBlock>
            </StackPanel>

            <!-- Productos -->
            <StackPanel Spacing="2">
              <TextBlock Classes="etiqueta" Text="Productos" />
              <ItemsControl ItemsSource="{Binding Detalle.Items}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="api:ItemVenta">
                    <TextBlock>
                      <Run Text="{Binding Cantidad}" />
                      <Run Text=" × " />
                      <Run Text="{Binding Descripcion}" />
                    </TextBlock>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <StackPanel Spacing="2" IsVisible="{Binding Detalle.Instrucciones, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <TextBlock Classes="etiqueta" Text="Instrucciones" />
              <TextBlock Text="{Binding Detalle.Instrucciones}" TextWrapping="Wrap" />
            </StackPanel>

            <!-- Acciones permitidas -->
            <TextBox Text="{Binding Nota}" Watermark="Nota (opcional)" />
            <ItemsControl ItemsSource="{Binding Acciones}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="6" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AccionTrabajo">
                  <Button Content="{Binding Texto}" Command="{Binding Comando}" Classes.primario="{Binding Principal}"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Classes="etiqueta" TextWrapping="Wrap"
                       Text="Los lentes se entregan solo si el saldo está en cero." />

            <!-- Historial -->
            <StackPanel Spacing="2">
              <TextBlock Classes="etiqueta" Text="Historial" />
              <ItemsControl ItemsSource="{Binding Detalle.Historial}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="api:HistorialTrabajo">
                    <StackPanel Margin="0,3">
                      <TextBlock>
                        <Run Text="{Binding CreadoLocal, StringFormat='{}{0:dd/MM HH:mm}'}" Foreground="{StaticResource TextoSuave}" />
                        <Run Text="  " />
                        <Run Text="{Binding Texto}" FontWeight="SemiBold" />
                        <Run Text="  " />
                        <Run Text="{Binding Usuario}" Foreground="{StaticResource TextoSuave}" />
                      </TextBlock>
                      <TextBlock Classes="etiqueta" Text="{Binding Nota}" TextWrapping="Wrap" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Border>
    </ScrollViewer>
  </Grid>
</UserControl>
