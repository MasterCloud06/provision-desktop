<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Provision.Desktop.ViewModels"
             xmlns:ui="using:Provision.Desktop.Controles"
             xmlns:api="using:Provision.Core.Api"
             x:Class="Provision.Desktop.Views.ClientesView"
             x:DataType="vm:ClientesViewModel">
  <Grid Margin="{StaticResource MargenPagina}" RowDefinitions="Auto,Auto,*" ColumnDefinitions="280,20,*">

    <Grid Grid.ColumnSpan="3" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
      <TextBlock Classes="titulo" Text="Clientes y salud visual" />
      <Button Grid.Column="1" Classes="primario" VerticalAlignment="Center"
              IsVisible="{Binding PuedeGestionar}" Command="{Binding AlternarNuevoCommand}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <ui:Icono Data="{x:Static ui:Iconos.Mas}" Width="16" Height="16" />
          <TextBlock Text="Nuevo cliente" />
        </StackPanel>
      </Button>
    </Grid>

    <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Spacing="6" Margin="0,0,0,12">
      <ProgressBar IsIndeterminate="True" IsVisible="{Binding Ocupado}" />
      <Border Classes="aviso-error" IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <TextBlock Classes="error" Text="{Binding Error}" />
      </Border>
      <Border Classes="aviso-ok" IsVisible="{Binding Aviso, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <TextBlock Classes="ok" Text="{Binding Aviso}" />
      </Border>
    </StackPanel>

    <!-- Búsqueda y lista -->
    <Border Grid.Row="2" Classes="superficie">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,8">
          <TextBlock Text="Directorio de clientes" Classes="subtitulo"/><TextBox Text="{Binding Busqueda}" Watermark="Nombre, CI o teléfono" ToolTip.Tip="Busca por nombre, CI, NIT o teléfono y presiona Enter">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding BuscarCommand}" />
            </TextBox.KeyBindings>
          </TextBox>
          <StackPanel Spacing="6" IsVisible="{Binding Creando}">
            <TextBox Text="{Binding NuevoNombre}" Watermark="Nombre completo" />
            <TextBox Text="{Binding NuevoCi}" Watermark="CI (opcional)" />
            <TextBox Text="{Binding NuevoTelefono}" Watermark="Teléfono (opcional)" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="primario" Content="Registrar" Command="{Binding CrearCommand}" />
              <Button Content="Cancelar" Command="{Binding AlternarNuevoCommand}" />
            </StackPanel>
          </StackPanel>
        </StackPanel>
        <Panel>
          <StackPanel Classes="vacio">
            <StackPanel.IsVisible>
              <MultiBinding Converter="{x:Static BoolConverters.And}">
                <Binding Path="!Ocupado" />
                <Binding Path="!Clientes.Count" />
              </MultiBinding>
            </StackPanel.IsVisible>
            <ui:Icono Data="{x:Static ui:Iconos.Clientes}" />
            <TextBlock Text="No encontramos clientes. Busca por nombre, CI o teléfono, o registra uno nuevo." />
          </StackPanel>
        <ListBox Classes="tabla" ItemsSource="{Binding Clientes}" SelectedItem="{Binding Seleccionado}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="api:Cliente">
              <StackPanel>
                <TextBlock Text="{Binding Nombre}" FontWeight="SemiBold" />
                <TextBlock Classes="etiqueta">
                  <Run Text="{Binding Ci, TargetNullValue='sin CI'}" />
                  <Run Text=" · " />
                  <Run Text="{Binding Telefono, TargetNullValue='sin teléfono'}" />
                </TextBlock>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        </Panel>
      </DockPanel>
    </Border>

    <!-- Ficha -->
    <ScrollViewer Grid.Row="2" Grid.Column="2">
      <StackPanel Spacing="16">
        <Border Classes="superficie" IsVisible="{Binding !HayFicha}" Padding="32"><StackPanel Spacing="16"><ui:Icono Data="{x:Static ui:Iconos.Clientes}" Width="40" Height="40" Foreground="{StaticResource Primario}" HorizontalAlignment="Left"/><TextBlock Text="Una ficha, toda su historia" FontSize="24" FontWeight="SemiBold"/><TextBlock Classes="etiqueta" Text="Selecciona un cliente del directorio para consultar sus datos, recetas y compras." TextWrapping="Wrap"/><Border Classes="banda"><TextBlock Text="Datos personales     ·     Recetas ópticas     ·     Historial comercial" TextWrapping="Wrap"/></Border></StackPanel></Border>

        <StackPanel Spacing="16" IsVisible="{Binding HayFicha}">
          <!-- Cabecera del expediente: quién es y cuánto debe, a la vista en las tres pestañas -->
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Border Width="48" Height="48" CornerRadius="24" Background="{StaticResource PrimarioSuave}" VerticalAlignment="Center">
              <ui:Icono Data="{x:Static ui:Iconos.Clientes}" Width="22" Height="22" Foreground="{StaticResource Primario}" HorizontalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center" Spacing="2">
              <TextBlock Text="{Binding Ficha.Nombre}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/>
              <TextBlock Classes="etiqueta">
                <Run Text="{Binding Ficha.Ci, Mode=OneWay, TargetNullValue='sin CI', StringFormat='CI {0}'}"/>
                <Run Text="  ·  "/>
                <Run Text="{Binding Ficha.Telefono, Mode=OneWay, TargetNullValue='sin teléfono'}"/>
              </TextBlock>
            </StackPanel>
            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
              <TextBlock Classes="etiqueta" FontSize="12" Text="Saldo pendiente" HorizontalAlignment="Right"/>
              <TextBlock Classes="cifra" FontSize="22" Text="{Binding Ficha.SaldoPendiente, Converter={StaticResource Bs}}" HorizontalAlignment="Right"/>
            </StackPanel>
          </Grid>
          <TabControl><TabControl.Styles><Style Selector="TabItem"><Setter Property="FontSize" Value="14"/><Setter Property="Padding" Value="12,8"/></Style></TabControl.Styles><TabItem Header="Datos personales">
          <Border Classes="superficie">
            <StackPanel Spacing="14">
              <TextBlock Classes="subtitulo" Text="Datos personales" />
              <StackPanel>
                <TextBlock Classes="campo" Text="Nombre completo" />
                <TextBox Text="{Binding EditNombre}" Watermark="Nombre y apellidos" IsReadOnly="{Binding !PuedeGestionar}" />
              </StackPanel>
              <Grid ColumnDefinitions="*,12,*">
                <StackPanel>
                  <TextBlock Classes="campo" Text="CI / NIT" />
                  <TextBox Text="{Binding EditCi}" Watermark="Documento" IsReadOnly="{Binding !PuedeGestionar}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Classes="campo" Text="Teléfono" />
                  <TextBox Text="{Binding EditTelefono}" Watermark="Celular o fijo" IsReadOnly="{Binding !PuedeGestionar}" />
                </StackPanel>
              </Grid>
              <Button Classes="primario" Content="Guardar datos" HorizontalAlignment="Left" Command="{Binding GuardarClienteCommand}" IsVisible="{Binding PuedeGestionar}" />
            </StackPanel>
          </Border>

          </TabItem><TabItem Header="Recetas ópticas">
          <!-- Recetas -->
          <Border Classes="superficie">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="subtitulo" Text="Recetas" />
                <Button Grid.Column="1" IsVisible="{Binding PuedeRecetar}"
                        Command="{Binding AlternarRecetaCommand}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <ui:Icono Data="{x:Static ui:Iconos.Mas}" Width="16" Height="16" />
          <TextBlock Text="Nueva receta" />
        </StackPanel>
      </Button>
              </Grid>

              <!-- Formulario de receta -->
              <Border Background="{StaticResource PrimarioSuave}" CornerRadius="8" Padding="12" IsVisible="{Binding CreandoReceta}">
                <StackPanel Spacing="8">
                  <Grid ColumnDefinitions="*,12,*">
                    <StackPanel>
                      <TextBlock Classes="campo" Text="Fecha del examen" />
                      <CalendarDatePicker SelectedDate="{Binding RecetaFecha}" HorizontalAlignment="Stretch" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Classes="campo" Text="Profesional" />
                      <TextBox Text="{Binding RecetaProfesional}" Watermark="Nombre de quien examinó" />
                    </StackPanel>
                  </Grid>
                  <Grid ColumnDefinitions="40,*,6,*,6,70,6,*" RowDefinitions="Auto,Auto,Auto">
                    <TextBlock Grid.Column="1" Classes="etiqueta" Text="Esfera" />
                    <TextBlock Grid.Column="3" Classes="etiqueta" Text="Cilindro" />
                    <TextBlock Grid.Column="5" Classes="etiqueta" Text="Eje" />
                    <TextBlock Grid.Column="7" Classes="etiqueta" Text="Adición" />

                    <TextBlock Grid.Row="1" Text="OD" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding OdEsfera}" Watermark="-1,25" Margin="0,2" />
                    <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding OdCilindro}" Watermark="-0,50" Margin="0,2" />
                    <TextBox Grid.Row="1" Grid.Column="5" Text="{Binding OdEje}" Watermark="180" Margin="0,2" />
                    <TextBox Grid.Row="1" Grid.Column="7" Text="{Binding OdAdicion}" Watermark="+2,00" Margin="0,2" />

                    <TextBlock Grid.Row="2" Text="OI" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding OiEsfera}" Margin="0,2" />
                    <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding OiCilindro}" Margin="0,2" />
                    <TextBox Grid.Row="2" Grid.Column="5" Text="{Binding OiEje}" Margin="0,2" />
                    <TextBox Grid.Row="2" Grid.Column="7" Text="{Binding OiAdicion}" Margin="0,2" />
                  </Grid>
                  <Grid ColumnDefinitions="*,8,*,8,2*">
                    <TextBox Text="{Binding DnpOd}" Watermark="DNP OD mm" />
                    <TextBox Grid.Column="2" Text="{Binding DnpOi}" Watermark="DNP OI mm" />
                    <TextBox Grid.Column="4" Text="{Binding UsoRecomendado}" Watermark="Uso: lejos, cerca, multifocal…" />
                  </Grid>
                  <TextBox Text="{Binding Observaciones}" Watermark="Observaciones" />
                  <TextBlock Classes="etiqueta" TextWrapping="Wrap"
                             Text="Esfera, cilindro y adición en pasos de 0,25. Si hay cilindro, el eje es obligatorio." />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="primario" Content="Guardar receta" Command="{Binding GuardarRecetaCommand}" />
                    <Button Content="Cancelar" Command="{Binding AlternarRecetaCommand}" />
                  </StackPanel>
                </StackPanel>
              </Border>

              <ItemsControl ItemsSource="{Binding Ficha.Recetas}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="api:Receta">
                    <Border BorderBrush="{StaticResource Borde}" BorderThickness="0,0,0,1" Padding="0,8">
                      <StackPanel Spacing="2">
                        <TextBlock Text="{Binding Resumen}" FontWeight="SemiBold" />
                        <!-- Graduación como se lee en una receta: una fila por ojo, una columna por valor -->
                        <Grid ColumnDefinitions="44,84,84,64,84" RowDefinitions="Auto,Auto,Auto" Margin="0,8,0,4" HorizontalAlignment="Left"
                              ToolTip.Tip="{Binding TextoOd}">
                          <TextBlock Grid.Column="1" Classes="th" Text="Esfera" HorizontalAlignment="Right" />
                          <TextBlock Grid.Column="2" Classes="th" Text="Cilindro" HorizontalAlignment="Right" />
                          <TextBlock Grid.Column="3" Classes="th" Text="Eje" HorizontalAlignment="Right" />
                          <TextBlock Grid.Column="4" Classes="th" Text="Adición" HorizontalAlignment="Right" />

                          <TextBlock Grid.Row="1" Text="OD" FontWeight="SemiBold" Margin="0,6,0,0" ToolTip.Tip="Ojo derecho" />
                          <TextBlock Grid.Row="1" Grid.Column="1" Classes="monto" Margin="0,6,0,0" HorizontalAlignment="Right" Text="{Binding OdEsfera, StringFormat='{}{0:+0.00;-0.00;0.00}', TargetNullValue='—'}" />
                          <TextBlock Grid.Row="1" Grid.Column="2" Classes="monto" Margin="0,6,0,0" HorizontalAlignment="Right" Text="{Binding OdCilindro, StringFormat='{}{0:+0.00;-0.00;0.00}', TargetNullValue='—'}" />
                          <TextBlock Grid.Row="1" Grid.Column="3" Classes="monto" Margin="0,6,0,0" HorizontalAlignment="Right" Text="{Binding OdEje, StringFormat='{}{0}°', TargetNullValue='—'}" />
                          <TextBlock Grid.Row="1" Grid.Column="4" Classes="monto" Margin="0,6,0,0" HorizontalAlignment="Right" Text="{Binding OdAdicion, StringFormat='{}{0:+0.00;-0.00;0.00}', TargetNullValue='—'}" />

                          <TextBlock Grid.Row="2" Text="OI" FontWeight="SemiBold" Margin="0,4,0,0" ToolTip.Tip="Ojo izquierdo" />
                          <TextBlock Grid.Row="2" Grid.Column="1" Classes="monto" Margin="0,4,0,0" HorizontalAlignment="Right" Text="{Binding OiEsfera, StringFormat='{}{0:+0.00;-0.00;0.00}', TargetNullValue='—'}" />
                          <TextBlock Grid.Row="2" Grid.Column="2" Classes="monto" Margin="0,4,0,0" HorizontalAlignment="Right" Text="{Binding OiCilindro, StringFormat='{}{0:+0.00;-0.00;0.00}', TargetNullValue='—'}" />
                          <TextBlock Grid.Row="2" Grid.Column="3" Classes="monto" Margin="0,4,0,0" HorizontalAlignment="Right" Text="{Binding OiEje, StringFormat='{}{0}°', TargetNullValue='—'}" />
                          <TextBlock Grid.Row="2" Grid.Column="4" Classes="monto" Margin="0,4,0,0" HorizontalAlignment="Right" Text="{Binding OiAdicion, StringFormat='{}{0:+0.00;-0.00;0.00}', TargetNullValue='—'}" />
                        </Grid>
                        <TextBlock Classes="etiqueta" Text="{Binding Observaciones}" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          </TabItem><TabItem Header="Historial comercial">
          <!-- Compras -->
          <Border Classes="superficie">
            <StackPanel Spacing="8">
              <TextBlock Classes="subtitulo" Text="Compras" />
              <TextBlock Classes="etiqueta" Text="Este cliente todavía no tiene compras." IsVisible="{Binding !Ficha.Compras.Count}" />
              <ItemsControl ItemsSource="{Binding Ficha.Compras}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="api:CompraCliente">
                    <Border BorderBrush="{StaticResource Borde}" BorderThickness="0,0,0,1" Padding="0,10">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                          <TextBlock Text="{Binding Numero}" FontWeight="SemiBold" />
                          <TextBlock Classes="etiqueta monto" Text="{Binding CreadoLocal, StringFormat='{}{0:dd/MM/yyyy}'}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                          <TextBlock Classes="monto" FontWeight="SemiBold" Text="{Binding Total, Converter={StaticResource Bs}}" HorizontalAlignment="Right" />
                          <TextBlock Classes="etiqueta monto" Text="{Binding Saldo, Converter={StaticResource Bs}, StringFormat='saldo {0}'}" HorizontalAlignment="Right" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          </TabItem></TabControl>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
