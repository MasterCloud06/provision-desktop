<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Provision.Desktop"
             xmlns:conv="using:Provision.Desktop.Conversores"
             x:Class="Provision.Desktop.App"
             RequestedThemeVariant="Light">

  <Application.DataTemplates>
    <!-- Cada XxxViewModel se muestra con su XxxView -->
    <local:ViewLocator />
  </Application.DataTemplates>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Tokens de diseño: colores, radios y sombras de la marca Provisión -->
        <ResourceInclude Source="/Estilos/Recursos.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <conv:CentavosConverter x:Key="Bs" />
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <!-- El color de acento de Fluent (foco, selección, casillas, progreso) es el verde cristal de la marca -->
        <ColorPaletteResources x:Key="Light" Accent="#17695F" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="/Estilos/Controles.axaml" />
  </Application.Styles>
</Application>
